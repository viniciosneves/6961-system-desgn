        <mxCell id="iyEj-Q7R-qJ3Ac0CptqH-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notas&lt;/h1&gt;&lt;p&gt;tamanho do video? - até 8gb, até 4k&lt;/p&gt;&lt;p&gt;que versões os clientes precisam? 1080p, 720p e 480p (áudio e as thumbnails)&lt;/p&gt;&lt;p&gt;quantos alunos? 5kk, qualquer dispositivo&lt;/p&gt;&lt;p&gt;quanto tempo até ficar disponível? até 1h depois do upload&lt;/p&gt;&lt;p&gt;temos restrição de orçamento? &lt;b&gt;sim, e forte&lt;/b&gt;&lt;/p&gt;&lt;p&gt;ao vivo? - não, fora de escopo&lt;/p&gt;" vertex="1">
          <mxGeometry height="290" width="450" x="60" y="810" as="geometry" />
        </mxCell>
        <mxCell id="iyEj-Q7R-qJ3Ac0CptqH-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Processamento&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;aula de duas horas, fatiada em pedaços de 10seg = 720 pedaços&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;três resoluções: +-2160 tarefas por video&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;com uma centena de máquinas trabalhando em paralelo, isso fecha em poucos minutos&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;- a janela de 1h é confortável &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;desde de que o trabalho seja paralelizável&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="450" x="560" y="800" as="geometry" />
        </mxCell>
        <mxCell id="iyEj-Q7R-qJ3Ac0CptqH-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Entrega&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;200k por dia, em média 30min cada&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;a 1.5 megabit por segundo, cada um consome +-340MB&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;200 mil x 340MB = +-68 TERAS por dia&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="450" x="60" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="iyEj-Q7R-qJ3Ac0CptqH-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Contrato&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;upload - devolve um id e o status (processando)&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;player pede os metadatos e recebe o endereço de cada resolução&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;player escolhe a resolução, não o servidor&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="450" x="560" y="1030" as="geometry" />
        </mxCell>
