        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;3 - regras de limite&lt;/font&gt;" vertex="1">
