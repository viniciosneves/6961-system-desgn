        <mxCell id="a3-db" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#1F53E5;strokeColor=#1F53E5;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#F4F5F6;whiteSpace=wrap;html=1;" value="banco relacional&lt;br&gt;(só) pedidos" vertex="1">
