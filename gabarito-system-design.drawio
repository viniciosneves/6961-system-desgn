        </mxCell>
        <mxCell id="a1-e9" edge="1" parent="1" source="a1-api3" style="endArrow=block;endFill=1;html=1;rounded=1;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;strokeColor=#011676;strokeWidth=2;fontColor=#011676;" target="a1-db" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notas&lt;/h1&gt;&lt;p&gt;Limite é global? -&amp;gt; por chave de API&lt;/p&gt;&lt;p&gt;Quantas chaves (ativas) existem? -&amp;gt; 50k chaves&lt;/p&gt;&lt;p&gt;Qual é o limite? 100 req por minuto por chave&lt;/p&gt;&lt;p&gt;Todo cliente aceita o mesmo comportamento? não, o app mobile faz 20 req de uma vez pra montar a tela. precisa de &lt;i&gt;BURST&lt;/i&gt;&lt;/p&gt;&lt;p&gt;O que acontece quando estoura? -&amp;gt; devolver um erro&lt;/p&gt;&lt;p&gt;Isso é pra contar algum tipo de ataque? -&amp;gt; não, DDOS fica fora do nosso escopo&lt;/p&gt;" vertex="1">
          <mxGeometry height="400" width="270" x="210" y="830" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Estimativas&lt;/h1&gt;&lt;p&gt;pico: 20k req por seg&lt;/p&gt;&lt;p&gt;estado: 1 contador por chave (50k contadores)&lt;/p&gt;&lt;p&gt;tamanho do contador: dezenas de bytes - &lt;b&gt;poucos mb pra armazenar o estado inteiro&lt;/b&gt;&lt;/p&gt;&lt;p&gt;orçamento pra latência: 1 ou 2ms, não mais do que isso&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="410" x="530" y="840" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-13" edge="1" parent="1" source="RGBv7QU_NhTEG5ZPUHKr-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="RGBv7QU_NhTEG5ZPUHKr-10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="425" />
              <mxPoint x="750" y="477.5" />
              <mxPoint x="570" y="477.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;1 - rate limiter&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="160" x="695" y="315" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Contrato&lt;/h1&gt;&lt;p&gt;entrada: chave da API (header)&lt;/p&gt;&lt;p&gt;saída quando passa; segue pra API normalmente&lt;/p&gt;&lt;p&gt;saída quando barra: 429 too many requests + Retry-After + header de cota&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="410" x="990" y="840" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-6" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;2 - Redis&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="105" x="722.5" y="530" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-7" edge="1" parent="1" source="RGBv7QU_NhTEG5ZPUHKr-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=classic;startFill=1;" target="RGBv7QU_NhTEG5ZPUHKr-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RGBv7QU_NhTEG5ZPUHKr-9" edge="1" parent="1" source="RGBv7QU_NhTEG5ZPUHKr-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="RGBv7QU_NhTEG5ZPUHKr-3">
          <mxGeometry relative="1" as="geometry" />
