        <mxCell id="fdCZdPvyfG0onCYrS15Z-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Estimativas&lt;/h1&gt;&lt;p&gt;- 10kk por dia, em média 5 buscas cada = 50kk de buscas&lt;/p&gt;&lt;p&gt;- cada busca tem +-8 teclas -&amp;gt; &lt;b&gt;400 milhões de consultas por dia&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;- &lt;/b&gt;média: +-4700 por segundo&amp;nbsp;&lt;/p&gt;&lt;p&gt;- pico de acesso, 14k por segundo&lt;/p&gt;&lt;p&gt;- orçamento: 100ms e2e, incluindo a viagem de rede&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="480" x="1480" y="280" as="geometry" />
        </mxCell>
