        </mxCell>
        <mxCell id="a2-e2" edge="1" parent="1" source="a2-p3" style="endArrow=block;endFill=1;html=1;rounded=1;fontFamily=Helvetica;fontSize=15;labelBackgroundColor=#FFFFFF;strokeColor=#011676;strokeWidth=2;fontColor=#011676;" target="a2-db3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sJ7I1HaMdDEgTzsFdgjo-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Notas&lt;/h1&gt;&lt;p&gt;Único global ou por região? global&lt;/p&gt;&lt;p&gt;Ordenação por tempo importa? sim, relatório e paginação dependem disso&lt;/p&gt;&lt;p&gt;Qual tamanho em bytes? 64bits - BIGINT no db&lt;/p&gt;&lt;p&gt;Pode existir coordenação entre regiões? não, uma região não pode ficar esperando a outra&lt;/p&gt;&lt;p&gt;Tem requisito de negócio? sim: o número não pode deixar o cliente calcular o nosso volume de pedidos&lt;/p&gt;" vertex="1">
          <mxGeometry height="390" width="410" x="80" y="760" as="geometry" />
        </mxCell>
        <mxCell id="sJ7I1HaMdDEgTzsFdgjo-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Estimativas&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&quot;&gt;pico: 10k pedidos por segundo (somando as regiões)&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;por dia: ˜860kk de pedidos&lt;/p&gt;&lt;p&gt;64 bits: comportam ordens de grandeza a mais do que isso&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="390" width="410" x="530" y="740" as="geometry" />
        </mxCell>
