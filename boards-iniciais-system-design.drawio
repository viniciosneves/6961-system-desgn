<mxfile host="app.diagrams.net"><diagram id="aula-1" name="Aula 1 · Rate limiter"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1440" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1-enun" value='&lt;font style="font-size:14px" color="#0429BC"&gt;&lt;b&gt;AULA 1 · RATE LIMITER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Tem gente batendo demais na API pública do marketplace, e isso tá derrubando os outros clientes. Desenha um rate limiter pra ela.' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=22;fontColor=#0C0C0E;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1280" height="110" as="geometry"/></mxCell><mxCell id="a1-app" value="app mobile" style="rounded=1;arcSize=18;fillColor=#011676;strokeColor=#0429BC;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#F4F5F6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="220" height="72" as="geometry"/></mxCell><mxCell id="a1-parc" value="parceiros" style="rounded=1;arcSize=18;fillColor=#011676;strokeColor=#0429BC;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#F4F5F6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="334" width="220" height="72" as="geometry"/></mxCell><mxCell id="a1-int" value="integração&lt;br&gt;de um cliente" style="rounded=1;arcSize=18;fillColor=#1F53E5;strokeColor=#1F53E5;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#F4F5F6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="80" y="478" width="220" height="72" as="geometry"/></mxCell><mxCell id="a1-lb" value="load balancer" style="rounded=1;arcSize=18;fillColor=#011676;strokeColor=#0429BC;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontColor=#F4F5F6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="334" width="200" height="72" as="geometry"/></mxCell><mxCell id="a1-rl" value="?" style="rounded=1;arcSize=18;fillCo